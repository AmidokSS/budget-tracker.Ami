{
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/reset-limits",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "SKIP_ENV_VALIDATION": "1"
  }
}